# Appvector MCP Server Configuration
# Copy this file to .env and fill in your actual values

# REQUIRED: Your Appvector API Token
# Obtain from your Appvector account dashboard
APPVECTOR_TOKEN = 1082a4db8516fffd9c92472b89551770ce9ef3b1
APPVECTOR_URL=https://appvector.io/external-apis/api
# OPTIONAL: Appvector API URL
# Default: https://toolstaging.maakeetoo.com/external-apis/api
# Uncomment and modify if using a different endpoint
# APPVECTOR_URL=https://your-api-endpoint.com

# OPTIONAL: Custom environment file path
# Use this if you want to store .env in a different location
# ENV_PATH=/path/to/your/.env

# Security Notes:
# 1. NEVER commit the actual .env file to git
# 2. Keep your API token secret and secure
# 3. Use different tokens for development and production
# 4. Rotate tokens regularly for security
# 5. This repository must remain PRIVATE

