# Step 1: Get this from console.cloud.google.com
# Go to APIs & Services → Credentials → Create API Key
# Enable "Places API (New)" on your project
GOOGLE_PLACES_API_KEY=PASTE_YOUR_PLACES_KEY_HERE

# Step 2: Get this from aistudio.google.com
# Click "Get API Key" → Create API key in new project
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE

# Keep these as-is
PORT=4000
